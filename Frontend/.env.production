# Used by `npm run build`. Baked into dist/, so the packaged desktop app (PakePlus/Tauri)
# talks to the live API instead of a relative /api/v1 path.
VITE_API_URL=https://ssmanage.peopleplusbd.com/api/v1

# Fallback only. The real realtime settings come from GET /me (realtime).
VITE_REVERB_HOST=ssmanage.peopleplusbd.com
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https
