        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.8",
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@types/three": "^0.170.0",
        "@vitejs/plugin-react": "^6.3.0",
        "axe-core": "^4.14.0",
        "eslint": "^10.14.0",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.7",
        "globals": "^17.14.0",
        "jsdom": "^31.0.0",
