{
    "name": "developer-report-frontend",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "engines": {
        "node": "^20.19.0 || >=22.12.0"
    },
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "preview": "vite preview",
        "lint": "eslint .",
        "format": "prettier --write src tests",
        "format:check": "prettier --check src tests",
        "types:check": "tsc -b --noEmit",
        "test": "vitest run",
        "voice:build": "node scripts/voice/build-voice-clips.mjs",
        "api:types": "openapi-typescript ../docs/mobile-api/openapi.json -o src/api/schema.d.ts",
        "check": "npm run check:style && npm run lint && npm run types:check && npm run test && npm run build",
        "check:style": "node scripts/check-style.mjs",
        "predev": "node scripts/check-node.mjs",
        "prebuild": "node scripts/check-node.mjs",
        "pretest": "node scripts/check-node.mjs",
        "prepreview": "node scripts/check-node.mjs",
        "e2e": "playwright test"
    },
    "dependencies": {
        "@fontsource-variable/geist-mono": "^5.3.0",
        "@fontsource-variable/noto-sans-bengali": "^5.3.0",
        "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
        "@hookform/resolvers": "^7.0.5",
        "@radix-ui/react-avatar": "^1.3.1",
        "@radix-ui/react-checkbox": "^1.4.1",
        "@radix-ui/react-dialog": "^1.3.1",
        "@radix-ui/react-dropdown-menu": "^2.2.1",
        "@radix-ui/react-label": "^2.1.17",
        "@radix-ui/react-select": "^2.4.1",
        "@radix-ui/react-slot": "^1.5.0",
        "@radix-ui/react-switch": "^1.4.1",
        "@radix-ui/react-tabs": "^1.2.1",
        "@radix-ui/react-tooltip": "^1.4.1",
        "@react-three/fiber": "^9.8.2",
        "@reduxjs/toolkit": "^2.14.0",
        "chart.js": "^4.6.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "laravel-echo": "^2.6.3",
        "lucide-react": "^1.70.0",
        "pusher-js": "^8.6.0",
        "react": "^19.3.1",
        "react-chartjs-2": "^5.3.1",
        "react-dom": "^19.3.1",
        "react-hook-form": "^7.91.0",
        "react-redux": "^9.3.1",
