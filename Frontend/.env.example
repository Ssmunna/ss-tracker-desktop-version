# Full URL of the Laravel API (Web/). The API must list this app's origin in FRONTEND_URL.
VITE_API_URL=http://localhost:8000/api/v1

# Fallback only. The real realtime settings come from GET /me (realtime).
VITE_REVERB_APP_KEY=
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8080
VITE_REVERB_SCHEME=http
